# Local/reference deployment defaults. No external AI API key is required.
DATABASE_URL=postgresql://agentforge:agentforge@localhost:5432/agentforge
AGENTFORGE_API_HOST=127.0.0.1
AGENTFORGE_API_PORT=8787
AGENTFORGE_EVENT_POLL_MS=250
AGENTFORGE_WORKER_ID=worker-local
AGENTFORGE_WORKER_CONCURRENCY=4
AGENTFORGE_CLAIM_BATCH_SIZE=4
AGENTFORGE_POLL_MS=250
AGENTFORGE_LEASE_MS=10000
AGENTFORGE_HEARTBEAT_MS=2500
AGENTFORGE_GRACEFUL_SHUTDOWN_MS=5000
AGENTFORGE_MAX_PAYLOAD_BYTES=1048576
AGENTFORGE_MAX_CHECKPOINT_BYTES=262144
LOG_LEVEL=info

# Optional OpenAI-compatible adapter variables for downstream applications only.
# They are not required by AgentForge core, tests, CI, or examples.
AGENTFORGE_PROVIDER_BASE_URL=
AGENTFORGE_PROVIDER_TOKEN=
AGENTFORGE_PROVIDER_MODEL=
